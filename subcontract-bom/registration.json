          "properties": {
            "from_drawing": {
              "type": "object",
              "additionalProperties": false,
              "x-mengos-count": true,
              "description": "从工程图读出的量。每一项写已有回执里那个值的引用；还没有回执的项不写。长度都以毫米计。",
              "properties": {
                "columns_read": {
                  "description": "主视图总长尺寸写成“列数*列距=总长”时照读的列数。给了它，列数就按它算。"
                },
                "run_length": {
                  "description": "沿巷道方向的总长。没有照读的列数时，列数由总长除以列距得出，与 column_pitch 一起给。"
                },
                "column_pitch": {
                  "description": "列距，与 run_length 一起给。"
                },
                "level_segments": {
                  "description": "层间距的段数：同一条竖向尺寸链上等于层间距的尺寸有几条。写数行回执里的条数，路径写 /count。"
                },
                "beam_clear": {
                  "description": "横梁净长 CE：货格图上显示文字以 CE 开头的那条尺寸的值。"
                },
                "zones": {
                  "type": "object",
                  "description": "各托盘区，一区一项。键写区名，与事实表里这个区的叫法相同，1–32 字，斜杠、波浪号、井号以外的字都可以用；值写这个区的托盘数和托盘的两个平面尺寸。",
                  "maxProperties": 20,
                  "propertyNames": {
                    "pattern": "^[^/~#]{1,32}$"
                  },
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "pallets": {
                        "description": "这个区的托盘数。"
                      },
                      "pallet_plan_a": {
                        "description": "这个区托盘的一个平面尺寸；另一个写在 pallet_plan_b，先写哪个都可以。"
                      },
                      "pallet_plan_b": {
                        "description": "这个区托盘的另一个平面尺寸。"
                      }
                    }
                  }
                }
              }
            }
          },
          "description": "要得到立库货架的列数、每排立柱片数、横梁层数，以及各托盘区的每格每层托盘数、排数、双深位组数、巷道数和合计时用：按本规范的推算规则，由读图得到的量算出。每个入参写一张已有回执里那个值的引用；引用写成 {\"$ref\": \"#/values/<名字>/value\"}：# 后面是这个值在回执里的位置，程序按位置找到给出它的那张回执。有两张回执在同一位置给出不同的值时，在 # 前面写上回执节点 id。还没有回执的入参不写。拿回算出的各项，可以在产物里引用；其余各项逐项列出还缺哪些入参。"
        },
