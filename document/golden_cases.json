  "payload": {
   "doc": {
    "title": "T",
    "sections": [
     {
      "heading": "A",
      "level": 1,
      "body": "[[fig:f1]]\n\n见[[fig:f2]]与[[fig:f1]]。\n\n[[fig:f2]]",
      "id": "s1"
     }
    ],
    "figures": [
     {
      "id": "f2",
      "caption": "图题f2",
      "source": {
       "svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 40 30\"><rect width=\"40\" height=\"30\" fill=\"#ddd\"/></svg>"
      }
     },
     {
      "id": "f1",
      "caption": "图题f1",
      "source": {
       "svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 40 30\"><rect width=\"40\" height=\"30\" fill=\"#ddd\"/></svg>"
      }
     }
    ]
   }
  },
  "expect": {
   "stats.figures": 2,
   "md_contains": [
    "见[图 2](#fig-f2)与[图 1](#fig-f1)。",
    "*图 1　图题f1*",
    "*图 2　图题f2*"
   ]
  }
 },
