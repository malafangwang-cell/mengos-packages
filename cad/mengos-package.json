{
  "package": "cad",
  "version": "2.6.0",
  "publisher": "mengos",
  "scope": "public",
  "title": "三维零件建模",
  "tool_titles": {
    "cad.build": "建三维零件模型",
    "cad.check": "核对零件尺寸与特征",
    "cad.export": "导出零件加工与图纸文件",
    "cad.compare": "比较零件改前改后的特征表"
  },
  "content_hash": "a32639075857bbca7c15a9683b80e84457ed3f3f9a4a22ffe5d9e021350fb65d",
  "types": [
    {
      "name": "cad_model",
      "parent": null,
      "kind": "deliverable",
      "realizes": [
        "assembly_model"
      ],
      "renderer": {
        "full": "renderer/index.html",
        "embed": {
          "file_role": "drawing"
        },
        "status": "正式渲染器，按渲染器契约 v0.1（数据经 postMessage 由宿主传入，本页不取网络数据）"
      },
      "note": "三维几何实体模型：零件或装配体。码本形态 assembly_model 由本类型实现（TL-27 拟定）"
    },
    {
      "name": "cad_part",
      "parent": "cad_model",
      "kind": "deliverable",
      "note": "单个零件。继承 cad_model 的 realizes 与渲染器。cad v2 只产出零件，不产出装配体"
    },
    {
      "name": "cad_plan",
      "parent": null,
      "kind": "value",
      "note": "行式零件计划（README §3）"
    },
    {
      "name": "cad_spec",
      "parent": null,
      "kind": "value",
      "note": "期望清单（README §4）"
    },
    {
      "name": "cad_file",
      "parent": null,
      "kind": "value",
      "note": "导出的文件集合，经 TL-9a 进入 ObjectStore；以通用文件卡片展示"
    },
    {
      "name": "cad_feature_table",
      "parent": null,
      "kind": "value",
      "note": "cad.build 产出里的特征表（features 与 part，2.6.0 起带面摘要）；只给 cad.compare 作入参"
    },
    {
      "name": "cad_diff",
      "parent": null,
      "kind": "value",
      "note": "两份特征表的比较结果：改了、随动、被修剪、新增、删去、零件级属性与逐行参数差（cad.compare 产出）。局部修改的服务端在 run 外直接调用，不经选择管线"
    }
  ],
  "uses_platform_types": [
    "verdict"
  ],
  "tools": "registration.json",
  "tools_lock": {
    "covers": [
      "cad_dsl.py",
      "builder.py",
      "geometry.py",
      "checker.py",
      "cad_tool.py",
      "pyproject.toml",
      "uv.lock",
      "registration.json"
    ],
    "note": "工具 version（lock hash）只覆盖这些文件；renderer/、samples/、tests/、README 不在其内，改它们不使认证失效（TL-25）"
  },
  "certification_material": {
    "golden_cases": "golden_cases.json",
    "selection_cases": "selection_cases.json",
    "golden_runner": "tools/run_golden.py"
  },
  "runtime": {
    "process": {
      "lang": "python",
      "requires": ">=3.12,<3.14",
      "project": "pyproject.toml",
      "lock": "uv.lock",
      "entry": "cad_tool.py",
      "network": "none",
      "workdir": true
    }
  },
  "certification": []
}
