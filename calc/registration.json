          "additionalProperties": false,
          "properties": {
            "expr": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000,
              "description": "expr：要求值的算式（不含等号），普通数学记法，例如 2^n + n^2、(3+4)*5、sqrt(8)、sin(30°)、ln(e)、log(8, 2)、10!、mod(17, 5)、\\frac{1}{3}。^ 与 ** 都是乘方；% 是百分号；° 是角度；ln 自然对数，lg 常用对数；常数 pi、e、I；支持 2x、2(x+1) 这类隐式乘法和全角符号。"
            },
            "bindings": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "number",
                  "string"
                ]
              },
              "description": "bindings：算式里每个变量的取值，变量名到数或表达式字符串，例如 {\"n\": 7} 或 {\"a\": \"1/3\"}。"
            },
            "digits": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "description": "digits：近似值的有效位数，缺省 30。"
            }
          },
          "description": "需要一个精确的计算结果、不想自己心算时用：一个算式等于多少。用平常的数学写法写（2^n、sqrt、°、%、10! 都认），算式里的每个变量在 bindings 里给出取值；拿回精确值（分数、根式、π 保持精确）和十进制近似。算式里的函数没有位数、步长一类的参数：log 的底、root 的次数、mod 的除数等都参与运算，与算式里其它的数一样对待。",
          "x-mengos-expr-params": {}
