 {
  "id": "b_div_zero",
  "note": "除以零：格子留空并告警，xlsx 用 IFERROR 包住",
  "tool": "table.build",
  "payload": {
   "table": {
    "title": "单价",
    "columns": [
     {
      "key": "a",
      "title": "金额",
      "type": "money"
     },
     {
      "key": "q",
      "title": "数量",
      "type": "integer"
     },
     {
      "title": "单价",
      "type": "money",
      "formula": "a / q"
     }
    ],
    "rows": [
     [
      100,
      4
     ],
     [
      50,
      0
     ]
    ]
   }
  },
  "expect": {
   "warnings[0].code": "div_zero",
   "stats.empty_cells": 1,
   "xlsx_contains": {
    "xl/worksheets/sheet1.xml": [
     "<f>IFERROR(A3/B3,\"\")</f>",
     "<f>IFERROR(A2/B2,\"\")</f><v>25</v>"
    ]
   },
   "md_contains": [
    "| 100.00 | 4 | 25.00 |"
   ]
  }
 },
 {
  "id": "b_round_fn",
  "note": "round 与 max：round(7/3, 2) = 2.33；max(2.33, 3) = 3",
  "tool": "table.build",
  "payload": {
   "table": {
    "title": "函数",
    "columns": [
     {
      "key": "a",
      "title": "甲",
      "type": "number"
     },
     {
      "key": "b",
      "title": "乙",
      "type": "number"
     },
     {
      "key": "r",
      "title": "商",
      "formula": "round(a / b, 2)"
     },
     {
      "title": "取大",
      "formula": "max(r, 3)"
     }
    ],
    "rows": [
     [
      7,
      3
     ]
    ]
   }
  },
  "expect": {
   "model_contains": [
    "\"2.33\"",
    "[\"7\",\"3\",\"2.33\",\"3\"]"
   ]
  }
 },
