[
 {
  "id": "b_simple",
  "note": "最简写法：列只写标题，类型按内容推断",
  "tool": "table.build",
  "payload": {
   "table": {
    "title": "季度销量",
    "columns": [
     "地区",
     "一季度",
     "二季度"
    ],
    "rows": [
     [
      "华东",
      120,
      135
     ],
     [
      "华南",
      98,
      110.5
     ]
    ]
   }
  },
  "expect": {
   "sheets[0].name": "季度销量",
   "sheets[0].rows": 2,
   "sheets[0].columns": [
    "地区",
    "一季度",
    "二季度"
   ],
   "stats.cells": 6,
   "stats.empty_cells": 0,
   "file_count": 4,
   "model_contains": [
    "\"type\":\"integer\"",
    "\"type\":\"number\"",
    "\"110.5\""
   ],
   "md_contains": [
    "| 地区 | 一季度 | 二季度 |",
    "| 华南 | 98 | 110.5 |"
   ]
  }
 },
 {
  "id": "b_formula_totals",
  "note": "公式列（数量 × 单价）与金额合计：860 + 2501 + 380 = 3741",
  "tool": "table.build",
  "payload": {
   "table": {
    "title": "减速机物料清单",
    "columns": [
     {
      "key": "part",
      "title": "零件"
     },
     {
      "key": "qty",
      "title": "数量",
      "type": "integer"
     },
     {
      "key": "price",
      "title": "单价",
      "type": "money",
      "unit": "元"
     },
     {
      "key": "amount",
      "title": "金额",
      "type": "money",
      "unit": "元",
      "formula": "qty * price"
     }
    ],
    "rows": [
     [
      "输入轴",
      1,
      860
     ],
     [
      "齿轮",
      2,
      1250.5
     ],
     [
      "轴承 6208",
      4,
      95
     ]
    ],
    "totals": [
     "金额"
    ]
   }
  },
  "expect": {
   "sheets[0].totals[0].column": "金额",
   "sheets[0].totals[0].fn": "sum",
   "sheets[0].totals[0].value": "3741",
   "stats.formula_columns": 1,
   "md_contains": [
    "| 齿轮 | 2 | 1,250.50 | 2,501.00 |",
    "| **合计** |  |  | **3,741.00** |",
    "公式：金额 = 数量 × 单价"
   ]
  }
 },
 {
  "id": "b_formula_excel",
  "note": "xlsx 里公式列写成 Excel 公式并带缓存值，合计写成 SUM",
  "tool": "table.build",
  "payload": {
   "table": {
    "title": "减速机物料清单",
    "columns": [
     {
      "key": "part",
      "title": "零件"
     },
     {
      "key": "qty",
      "title": "数量",
      "type": "integer"
     },
     {
      "key": "price",
      "title": "单价",
      "type": "money",
      "unit": "元"
     },
     {
      "key": "amount",
      "title": "金额",
      "type": "money",
      "unit": "元",
      "formula": "qty * price"
     }
    ],
    "rows": [
     [
      "输入轴",
      1,
      860
     ],
     [
      "齿轮",
      2,
      1250.5
     ],
     [
      "轴承 6208",
      4,
      95
     ]
    ],
    "totals": [
     "金额"
    ]
   }
  },
  "expect": {
   "xlsx_contains": {
    "xl/worksheets/sheet1.xml": [
     "<f>B3*C3</f><v>2501</v>",
     "<f>SUM(D2:D4)</f><v>3741</v>"
    ]
   }
  }
 },
 {
  "id": "b_percent",
  "note": "百分比列写百分数：12.5 与 \"8%\" 都按百分数，存为小数；平均 (12.5+8+(-3.25))/3=5.75%，按 1 位小数记为 5.8%",
  "tool": "table.build",
  "payload": {
   "table": {
    "title": "增长率",
    "columns": [
     {
      "title": "部门"
     },
     {
      "title": "增长",
      "type": "percent",
      "decimals": 1
     }
    ],
    "rows": [
     [
      "甲",
      12.5
     ],
     [
      "乙",
      "8%"
     ],
     [
      "丙",
      -3.25
     ]
    ],
    "totals": [
     {
      "column": "增长",
      "fn": "avg"
     }
    ]
   }
  },
  "expect": {
   "sheets[0].totals[0].value": "0.058",
   "model_contains": [
    "\"0.125\"",
    "\"0.08\"",
    "\"-0.0325\""
   ],
   "md_contains": [
    "| 甲 | 12.5% |",
    "| 丙 | -3.3% |",
    "| **平均** | **5.8%** |"
   ]
  }
 },
 {
